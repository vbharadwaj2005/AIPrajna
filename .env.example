# ── HuggingFace (required) ─────────────────────────────────────
HUGGINGFACE_API_KEY=hf_your_token_here
HUGGINGFACE_MODEL=microsoft/Phi-3-mini-4k-instruct

# ── Embedding Model (local — no key required) ──────────────────
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── Cross-Encoder Reranker (local — no key required) ──────────
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ── Chunking ───────────────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# ── Retrieval ──────────────────────────────────────────────────
TOP_K_INITIAL=20
TOP_K_RERANKED=5
HYBRID_WEIGHT_DENSE=0.5

# ── Vector DB ─────────────────────────────────────────────────
COLLECTION_NAME=aiprajna

# ── Limits ──────────────────────────────────────────────────────
MAX_INPUT_LENGTH=4096
